{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "no-inline-styles": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "min-height: auto",
          "backdrop-filter",
          "mask-image",
          "scrollbar-width",
          "scrollbar-width: thin"
        ]
      }
    ],
    "css-prefix-order": "off"
  }
}